# NOTE: school_pos/static/ is intentionally TRACKED.
# STATICFILES_STORAGE uses CompressedManifestStaticFilesStorage, which raises
# "Missing staticfiles manifest entry" (HTTP 500 on every Django admin page)
# when css/admin_custom.css is absent from the build.
!school_pos/static/
!school_pos/static/**

